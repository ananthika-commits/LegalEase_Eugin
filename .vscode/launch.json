{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI Backend (Uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "jinja": true,
            "justMyCode": true,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Streamlit Frontend",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py",
                "--server.port",
                "8501"
            ],
            "justMyCode": true,
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Run Pytest Suite",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "tests"
            ],
            "justMyCode": true
        }
    ],
    "compounds": [
        {
            "name": "LegalEase: Full Stack (Backend + Frontend)",
            "configurations": [
                "FastAPI Backend (Uvicorn)",
                "Streamlit Frontend"
            ]
        }
    ]
}
